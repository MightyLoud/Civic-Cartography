+
+
+@pytest.mark.parametrize("blank_lsad", [None, "", "   ", "None", "null"])
+def test_infer_jurisdiction_seed_treats_blank_lsad_as_absent(
+    blank_lsad: str | None,
+) -> None:
+    seed = infer_jurisdiction_seed(
+        "ocd-division/country:us/state:wa/county:pierce",
+        lsad_code=blank_lsad,
+    )
+
+    assert seed.has_jurisdiction is True
+    assert seed.classification == ClassificationEnum.GOVERNMENT.value
+    assert seed.reason == "general government fallback"
+
+
+@pytest.mark.parametrize("blank_lsad", ["", "None", "null"])
+def test_blank_lsad_allows_school_district_classification(blank_lsad: str) -> None:
+    seed = infer_jurisdiction_seed(
+        "ocd-division/country:us/state:co/county:el_paso/"
+        "school_district:colorado_springs_school_district_no._11",
+        lsad_code=blank_lsad,
+    )
+
+    assert seed.has_jurisdiction is True
+    assert seed.classification == ClassificationEnum.SCHOOL_SYSTEM.value
+    assert seed.reason == "school district geography"
+
+
+def test_lsad_list_repr_uses_first_normalized_code() -> None:
+    seed = infer_jurisdiction_seed(
+        "ocd-division/country:us/state:ca/place:example",
+        lsad_code="['57', '25']",
+    )
+
+    assert seed.has_jurisdiction is False
+    assert seed.reason == "statistical geography"
+
+
+def test_normalization_does_not_hide_unknown_nonblank_lsad() -> None:
+    with pytest.raises(ValueError, match="Unknown LSAD code 'ZZ'"):
+        infer_jurisdiction_seed(
