@@ -0,0 +1,126 @@
+from types import SimpleNamespace
+from uuid import UUID
+
+import polars as pl
+import pytest
+
+import src.init_migration.generate_pipeline as generate_pipeline
+from src.init_migration.generate_pipeline import GeneratePipeline, NoMatch
+from src.init_migration.pipeline_models import OCDidIngestResp, Status
+from src.models.ocdid import OCDIdParsed
+
+
+PIERCE_OCDID = "ocd-division/country:us/state:wa/county:pierce"
+TEST_UUID = UUID("0f42b7c3-4e0a-4e6d-b2b1-720a8d4e8079")
+
+
+def _ingest(ocdid: str = PIERCE_OCDID) -> OCDidIngestResp:
+    return OCDidIngestResp(
+        uuid=TEST_UUID,
+        ocdid=OCDIdParsed.parse_ocdid(ocdid),
+        raw_record={"id": ocdid, "name": "Pierce County"},
+    )
+
+
+@pytest.mark.asyncio
+async def test_no_validation_match_continues_to_jurisdiction_classification(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path,
+) -> None:
+    data = _ingest()
+    pipeline = GeneratePipeline.__new__(GeneratePipeline)
+    pipeline.req = SimpleNamespace(data=data)
+    pipeline.data = data
+    pipeline.uuid = data.uuid
+    pipeline.division_output_dir = tmp_path
+    pipeline.jurisdiction_output_dir = tmp_path
+    pipeline.quarantine = NoMatch()
+    pipeline.created_jurisdictions = set()
+    pipeline.division = None
+    pipeline.jurisdiction = None
+    pipeline.find_matches = lambda _: pl.DataFrame()
+
+    division = SimpleNamespace(
+        ocdid=PIERCE_OCDID,
+        government_identifiers=SimpleNamespace(lsad=""),
+    )
+    division_path = tmp_path / "divisions/wa/local/pierce.yaml"
+
+    class FakeDivGenerator:
+        def __init__(self, req) -> None:
+            assert req is pipeline.req
+
+        def generate_division_stub(self, uuid):
+            assert uuid == TEST_UUID
+            return division
+
+        def dump_division(self, output_dir):
+            assert output_dir == tmp_path
+            return division_path
+
+    monkeypatch.setattr(generate_pipeline, "DivGenerator", FakeDivGenerator)
+
+    classification_calls: list[str | None] = []
+
+    def continue_classification(response, *, lsad_code):
+        classification_calls.append(lsad_code)
+
+    pipeline._generate_jurisdiction_for_division = continue_classification
+
+    response = await pipeline.run()
+
+    assert classification_calls == [None]
+    assert response.division_path == str(division_path)
+    assert response.status.status is Status.PARTIAL
+    assert response.status.error == "No validation match found"
+    assert pipeline.quarantine.ocdid_no_validation_div == [
+        {
+            "ocdid": PIERCE_OCDID,
+            "reason": "no_validation_match",
+            "matched_records": [],
+        }
+    ]
+
+
+def test_stub_division_can_generate_ocdid_classified_jurisdiction(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path,
+) -> None:
+    pipeline = GeneratePipeline.__new__(GeneratePipeline)
+    pipeline.req = SimpleNamespace()
+    pipeline.uuid = TEST_UUID
+    pipeline.division = SimpleNamespace(ocdid=PIERCE_OCDID)
+    pipeline.jurisdiction = None
+    pipeline.created_jurisdictions = set()
+    pipeline.jurisdiction_output_dir = tmp_path
+    response = SimpleNamespace(jurisdiction_path=None)
+
+    classifier_call = {}
+
+    def fake_infer_jurisdiction_seed(*, ocdid, lsad_code):
+        classifier_call.update({"ocdid": ocdid, "lsad_code": lsad_code})
+        return SimpleNamespace(
+            has_jurisdiction=True,
+            classification="government",
+            reason="general government fallback",
+        )
+
+    jurisdiction_path = tmp_path / "jurisdictions/wa/local/pierce.yaml"
+
+    class FakeJurGenerator:
+        def __init__(self, req, division) -> None:
+            assert req is pipeline.req
+            assert division is pipeline.division
+
+        def generate_jurisdiction(self, *, division, uuid, classification):
+            assert division is pipeline.division
+            assert uuid == TEST_UUID
+            assert classification == "government"
+            return SimpleNamespace()
+
+        def dump_jurisdiction(self, output_dir):
+            assert output_dir == tmp_path
+            return jurisdiction_path
+
+    monkeypatch.setattr(
+        generate_pipeline, "infer_jurisdiction_seed", fake_infer_jurisdiction_seed
+    )
+    monkeypatch.setattr(generate_pipeline, "JurGenerator", FakeJurGenerator)
+
+    pipeline._generate_jurisdiction_for_division(response, lsad_code=None)
+
+    expected_ocdid = (
+        "ocd-jurisdiction/country:us/state:wa/county:pierce/government"
+    )
+    assert classifier_call == {"ocdid": PIERCE_OCDID, "lsad_code": None}
+    assert response.jurisdiction_path == str(jurisdiction_path)
+    assert pipeline.created_jurisdictions == {expected_ocdid}
