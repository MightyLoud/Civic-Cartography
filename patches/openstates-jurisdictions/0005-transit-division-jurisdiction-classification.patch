diff --git a/tests/src/init_migration/test_jurisdiction_seed_transit.py b/tests/src/init_migration/test_jurisdiction_seed_transit.py
new file mode 100644
index 0000000..b75370f
--- /dev/null
+++ b/tests/src/init_migration/test_jurisdiction_seed_transit.py
@@ -0,0 +1,17 @@
+from src.init_migration.jurisdiction_seed import infer_jurisdiction_seed
+from src.models.jurisdiction import ClassificationEnum
+
+
+def test_transit_division_creates_transit_authority_jurisdiction() -> None:
+    seed = infer_jurisdiction_seed(
+        "ocd-division/country:us/state:il/transit:rta",
+        lsad_code=None,
+    )
+
+    assert seed.has_jurisdiction is True
+    assert seed.classification == ClassificationEnum.TRANSIT_AUTHORITY.value
+    assert (
+        seed.jurisdiction_type_suffix
+        == ClassificationEnum.TRANSIT_AUTHORITY.value
+    )
+    assert seed.reason == "transit authority geography"
