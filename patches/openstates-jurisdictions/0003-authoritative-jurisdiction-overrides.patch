diff --git a/tests/src/init_migration/test_authoritative_jurisdiction_override.py b/tests/src/init_migration/test_authoritative_jurisdiction_override.py
new file mode 100644
index 0000000..5555555
--- /dev/null
+++ b/tests/src/init_migration/test_authoritative_jurisdiction_override.py
@@ -0,0 +1,104 @@
+from types import SimpleNamespace
+from uuid import UUID
+
+import src.init_migration.generate_pipeline as generate_pipeline
+from src.init_migration.generate_pipeline import GeneratePipeline
+
+
+RTD_OCDID = (
+    "ocd-division/country:us/state:co/"
+    "special_district:regional_transportation_district"
+)
+TEST_UUID = UUID("ac8f7f0d-fdb4-59d2-9915-187f34b32a89")
+
+
+def test_pipeline_passes_embedded_override_and_updates_division_reference(
+    monkeypatch,
+    tmp_path,
+) -> None:
+    override = {
+        "has_jurisdiction": True,
+        "classification": "transit_authority",
+        "jurisdiction_name": "Regional Transportation District",
+        "jurisdiction_type_suffix": "transit_authority",
+        "url": "https://www.rtd-denver.com/",
+    }
+    raw_record = {"_jurisdiction_override": override}
+    pipeline = GeneratePipeline.__new__(GeneratePipeline)
+    pipeline.req = SimpleNamespace(jurisdiction_override=None)
+    pipeline.data = SimpleNamespace(raw_record=raw_record)
+    pipeline.uuid = TEST_UUID
+    pipeline.division = SimpleNamespace(ocdid=RTD_OCDID, jurisdiction_id=None)
+    pipeline.jurisdiction = None
+    pipeline.created_jurisdictions = set()
+    pipeline.division_output_dir = tmp_path
+    pipeline.jurisdiction_output_dir = tmp_path
+    response = SimpleNamespace(division_path=None, jurisdiction_path=None)
+
+    classifier_call = {}
+
+    def fake_infer_jurisdiction_seed(**kwargs):
+        classifier_call.update(kwargs)
+        return SimpleNamespace(
+            has_jurisdiction=True,
+            classification="transit_authority",
+            reason="exact override",
+        )
+
+    division_path = tmp_path / "divisions/co/local/rtd.yaml"
+    jurisdiction_path = tmp_path / "jurisdictions/co/local/rtd.yaml"
+
+    class FakeDivGenerator:
+        def __init__(self, req):
+            assert req is pipeline.req
+            self.division = None
+
+        def dump_division(self, output_dir):
+            assert self.division is pipeline.division
+            assert output_dir == tmp_path
+            return division_path
+
+    class FakeJurGenerator:
+        def __init__(self, req, division):
+            assert req is pipeline.req
+            assert division is pipeline.division
+
+        def generate_jurisdiction(self, *, division, uuid, classification):
+            assert division is pipeline.division
+            assert uuid == TEST_UUID
+            assert classification == "transit_authority"
+            return SimpleNamespace()
+
+        def dump_jurisdiction(self, output_dir):
+            assert output_dir == tmp_path
+            return jurisdiction_path
+
+    monkeypatch.setattr(
+        generate_pipeline, "infer_jurisdiction_seed", fake_infer_jurisdiction_seed
+    )
+    monkeypatch.setattr(generate_pipeline, "DivGenerator", FakeDivGenerator)
+    monkeypatch.setattr(generate_pipeline, "JurGenerator", FakeJurGenerator)
+
+    pipeline._generate_jurisdiction_for_division(response, lsad_code=None)
+
+    expected_jurisdiction_id = (
+        "ocd-jurisdiction/country:us/state:co/"
+        "special_district:regional_transportation_district/transit_authority"
+    )
+    assert classifier_call["exact_override"] == override
+    assert pipeline.division.jurisdiction_id == expected_jurisdiction_id
+    assert response.division_path == str(division_path)
+    assert response.jurisdiction_path == str(jurisdiction_path)
+    assert pipeline.created_jurisdictions == {expected_jurisdiction_id}
