diff --git a/tests/src/init_migration/test_territory_municipio.py b/tests/src/init_migration/test_territory_municipio.py
new file mode 100644
index 0000000000000000000000000000000000000000..a31eea57a17f844db4e4479b2a0f36698b3883da
--- /dev/null
+++ b/tests/src/init_migration/test_territory_municipio.py
@@ -0,0 +1,132 @@
+from types import SimpleNamespace
+from uuid import UUID
+
+import polars as pl
+
+from src.init_migration.generate_division import DivGenerator
+from src.init_migration.generate_jurisdiction import JurGenerator
+from src.init_migration.generate_pipeline import GeneratePipeline
+from src.init_migration.generate_recursive import ensure_ancestor_stubs
+from src.init_migration.jurisdiction_seed import infer_jurisdiction_seed
+from src.models.ocdid import OCDIdParsed
+
+
+SAN_JUAN_OCDID = (
+    "ocd-division/country:us/territory:pr/municipio:san_juan"
+)
+SAN_JUAN_JURISDICTION_OCDID = (
+    "ocd-jurisdiction/country:us/territory:pr/municipio:san_juan/government"
+)
+TEST_UUID = UUID("4ad24c3e-e2c2-58c4-a115-f0cdf719a8e6")
+
+
+def test_territory_municipio_resolves_validation_by_master_geoid() -> None:
+    pipeline = GeneratePipeline.__new__(GeneratePipeline)
+    pipeline.req = SimpleNamespace(jurisdiction_override=None)
+    pipeline.data = SimpleNamespace(
+        raw_record={"census_geoid": "place-72127"}
+    )
+    pipeline.validation_df = pl.DataFrame(
+        [
+            {
+                "STATEFP": "72",
+                "NAMELSAD": "San Juan Municipio",
+                "GEOID_Census": "72127",
+                "normalized_place_name": "san juan",
+            },
+            {
+                "STATEFP": "72",
+                "NAMELSAD": "San Juan zona urbana",
+                "GEOID_Census": "7276770",
+                "normalized_place_name": "san juan",
+            },
+        ]
+    )
+
+    matches = pipeline.find_matches(SAN_JUAN_OCDID)
+
+    assert len(matches) == 1
+    assert matches.row(0, named=True)["GEOID_Census"] == "72127"
+
+
+def test_municipio_classifies_as_general_government() -> None:
+    seed = infer_jurisdiction_seed(SAN_JUAN_OCDID, lsad_code=None)
+
+    assert seed.has_jurisdiction is True
+    assert seed.classification == "government"
+    assert seed.reason == "general government fallback"
+
+
+def test_municipio_jurisdiction_uses_national_master_name() -> None:
+    request = SimpleNamespace(
+        data=SimpleNamespace(
+            raw_record={"name": "San Juan Municipio"},
+            ocdid=SimpleNamespace(raw_ocdid=SAN_JUAN_OCDID),
+        ),
+        jurisdiction_ai_url=False,
+    )
+    generator = JurGenerator(request)
+    division = SimpleNamespace(
+        ocdid=SAN_JUAN_OCDID,
+        display_name="San Juan",
+    )
+
+    jurisdiction = generator.generate_jurisdiction(
+        division=division,
+        uuid=TEST_UUID,
+        classification="government",
+    )
+
+    assert jurisdiction.name == "San Juan Municipio"
+    assert jurisdiction.ocdid == SAN_JUAN_JURISDICTION_OCDID
+
+
+def test_territory_leaf_artifacts_route_to_postal_code_directory(tmp_path) -> None:
+    division = SimpleNamespace(
+        ocdid=SAN_JUAN_OCDID,
+        id=TEST_UUID,
+        display_name="San Juan Municipio",
+        government_identifiers=SimpleNamespace(geoid="72127"),
+        model_dump=lambda **_: {
+            "ocdid": SAN_JUAN_OCDID,
+            "display_name": "San Juan Municipio",
+            "government_identifiers": {"geoid": "72127"},
+        },
+    )
+    div_generator = DivGenerator.__new__(DivGenerator)
+    div_generator.division = division
+
+    division_path = div_generator.dump_division(output_dir=tmp_path)
+
+    jurisdiction = SimpleNamespace(
+        ocdid=SAN_JUAN_JURISDICTION_OCDID,
+        id=TEST_UUID,
+        model_dump=lambda **_: {
+            "ocdid": SAN_JUAN_JURISDICTION_OCDID,
+            "name": "San Juan Municipio",
+            "classification": "government",
+        },
+    )
+    jur_generator = JurGenerator.__new__(JurGenerator)
+    jur_generator.jurisdiction = jurisdiction
+    jur_generator.req = SimpleNamespace(
+        data=SimpleNamespace(
+            ocdid=SimpleNamespace(raw_ocdid=SAN_JUAN_OCDID)
+        )
+    )
+
+    jurisdiction_path = jur_generator.dump_jurisdiction(output_dir=tmp_path)
+
+    assert division_path.parent == tmp_path / "divisions" / "pr" / "local"
+    assert jurisdiction_path.parent == tmp_path / "jurisdictions" / "pr" / "local"
+
+
+def test_territory_ancestor_stubs_route_to_postal_code_directory(tmp_path) -> None:
+    parsed = OCDIdParsed.parse_ocdid(SAN_JUAN_OCDID)
+
+    results = ensure_ancestor_stubs(parsed, tmp_path, tmp_path)
+
+    assert len(results) == 1
+    assert results[0]["level"] == "territory"
+    assert "/divisions/pr/" in results[0]["division_path"]
+    assert "/jurisdictions/pr/" in results[0]["jurisdiction_path"]

