{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REL-FAC promotion and exception report",
  "type": "object",
  "required": ["gate_id", "qa_status", "promotion_status", "release_status", "promotion_eligible", "release_eligible", "exceptions"],
  "properties": {
    "gate_id": {"type": "string", "minLength": 1},
    "qa_status": {"enum": ["PASS", "REVIEW", "FAIL"]},
    "promotion_status": {"enum": ["READY", "QUEUED", "BLOCKED"]},
    "release_status": {"enum": ["HOLD", "RELEASED"]},
    "promotion_eligible": {"type": "boolean"},
    "release_eligible": {"type": "boolean"},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exception_id", "factory", "gate_id", "exception_type", "severity", "blocking", "status", "description"],
        "properties": {
          "exception_id": {"type": "string"},
          "factory": {"type": "string"},
          "gate_id": {"type": "string"},
          "entity_type": {"type": ["string", "null"]},
          "entity_id": {"type": ["string", "null"]},
          "exception_type": {"type": "string"},
          "severity": {"enum": ["INFO", "REVIEW", "BLOCKING", "ERROR"]},
          "blocking": {"type": "boolean"},
          "status": {"enum": ["OPEN", "QUEUED", "RESOLVED", "CLOSED"]},
          "owner": {"type": ["string", "null"]},
          "source_id": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "resolution": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
