{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mightyloud.github.io/Civic-Cartography/schemas/target-result-report.schema.json",
  "title": "Civic Cartography Target Result Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_name",
    "manifest_sha256",
    "execution_results_sha256",
    "run_asof",
    "run_id",
    "states",
    "summary",
    "results"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_name": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_results_sha256": {"type": ["string", "null"]},
    "run_asof": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "states": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z]{2}$"},
      "uniqueItems": true
    },
    "summary": {"$ref": "#/$defs/summary"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "ocdid"},
            "value": {"type": "string", "pattern": "^ocd-division/"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "resolution_policy"],
          "properties": {
            "type": {"const": "explicit_lookup"},
            "name": {"type": "string", "minLength": 1},
            "resolution_policy": {"const": "override_or_exception"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "members", "canonical_rule"],
          "properties": {
            "type": {"const": "alias_group"},
            "members": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^ocd-division/"}
            },
            "canonical_rule": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "state_count",
        "fixture_count",
        "discovery_count",
        "selector_counts",
        "generation_counts",
        "exception_count"
      ],
      "properties": {
        "target_count": {"type": "integer", "minimum": 1},
        "state_count": {"type": "integer", "minimum": 1},
        "fixture_count": {"type": "integer", "minimum": 0},
        "discovery_count": {"type": "integer", "minimum": 0},
        "production_count": {"type": "integer", "minimum": 1},
        "selector_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "generation_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "exception_count": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "jurisdiction_name",
        "state",
        "category",
        "expected_archetype",
        "requested_selector",
        "resolved_ocdids",
        "match_status",
        "expected_classification",
        "inferred_classification",
        "classification_status",
        "generation_status",
        "division_paths",
        "jurisdiction_paths",
        "exception_class",
        "review_reason",
        "human_minutes",
        "output_hashes"
      ],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "jurisdiction_name": {"type": "string", "minLength": 1},
        "state": {"type": "string", "pattern": "^[a-z]{2}$"},
        "category": {
          "enum": [
            "regression_fixture",
            "new_known_archetype",
            "discovery",
            "production"
          ]
        },
        "census_geoid": {"type": "string", "pattern": "^[0-9]{7}$"},
        "wave": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "expected_archetype": {"type": "string", "minLength": 1},
        "requested_selector": {"$ref": "#/$defs/selector"},
        "resolved_ocdids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "match_status": {
          "enum": [
            "resolved",
            "matched",
            "unresolved",
            "alias_group_pending",
            "not_found",
            "ambiguous"
          ]
        },
        "expected_classification": {"type": "string", "minLength": 1},
        "inferred_classification": {"type": ["string", "null"]},
        "classification_status": {
          "enum": ["not_evaluated", "matched", "mismatch", "not_applicable"]
        },
        "generation_status": {
          "enum": ["not_run", "generated", "partial", "failed", "skipped"]
        },
        "division_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "jurisdiction_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "exception_class": {"type": ["string", "null"]},
        "review_reason": {"type": ["string", "null"]},
        "human_minutes": {"type": ["number", "null"], "minimum": 0},
        "output_hashes": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
