{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "status",
    "mode",
    "target_id",
    "register_blob_verified",
    "evidence_run_id",
    "qa_facts",
    "promotion_ready",
    "held_locks",
    "handoffs",
    "event_count",
    "event_trace_sha256",
    "deterministic",
    "tamper_probes",
    "report_sha256"
  ],
  "properties": {
    "gate_id": {
      "const": "ORCH-FAC-008"
    },
    "status": {
      "const": "PASS"
    },
    "mode": {
      "const": "READ_ONLY_EVIDENCE_REPLAY"
    },
    "target_id": {
      "const": "MB100-100"
    },
    "register_blob_verified": {
      "const": true
    },
    "evidence_run_id": {
      "const": 31658600741
    },
    "qa_facts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "status"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "status": {
            "const": "PASS"
          }
        }
      }
    },
    "promotion_ready": {
      "const": true
    },
    "held_locks": {
      "const": 0
    },
    "handoffs": {
      "const": 1
    },
    "event_count": {
      "type": "integer",
      "minimum": 20
    },
    "event_trace_sha256": {
      "pattern": "^[0-9a-f]{64}$"
    },
    "deterministic": {
      "const": true
    },
    "tamper_probes": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "const": "REJECTED"
      }
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
