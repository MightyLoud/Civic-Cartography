{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicdata.tech/schemas/orch-fac-002-orchestration.schema.json",
  "title": "ORCH-FAC-002 evidence-derived orchestration fixture",
  "type": "object",
  "required": ["version", "nonwriting_workers", "cases"],
  "properties": {
    "version": {"const": 2},
    "nonwriting_workers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["case_id", "domain_factory", "stage_checks"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "domain_factory": {"type": "string", "minLength": 1},
          "final_handoff": {"enum": ["PROGRAM-CONTROL"]},
          "stage_checks": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": {"$ref": "#/$defs/checks"},
              "domain": {"$ref": "#/$defs/checks"},
              "qa": {"$ref": "#/$defs/checks"},
              "rel": {"$ref": "#/$defs/checks"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["check_id", "status", "detail"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "REVIEW", "FAIL"]},
        "detail": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "additionalProperties": false
}
