{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicdata.tech/schemas/orch-fac-002-orchestration.schema.json",
  "title": "ORCH-FAC-002 fixture orchestration contract",
  "type": "object",
  "required": ["version", "read_only_workers", "cases"],
  "properties": {
    "version": {"const": 1},
    "read_only_workers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "domain_factory", "outcomes", "final_handoff", "expected"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "domain_factory": {"type": "string", "minLength": 1},
          "outcomes": {
            "type": "object",
            "required": ["source", "domain", "qa", "release"],
            "properties": {
              "source": {"enum": ["PASS", "REVIEW", "FAIL"]},
              "domain": {"enum": ["PASS", "REVIEW", "FAIL"]},
              "qa": {"enum": ["PASS", "REVIEW", "FAIL"]},
              "release": {"enum": ["PASS", "REVIEW", "FAIL"]}
            },
            "additionalProperties": false
          },
          "final_handoff": {"type": "string", "minLength": 1},
          "expected": {
            "type": "object",
            "required": ["terminal_status", "terminal_route", "stages_executed", "held_locks"],
            "properties": {
              "terminal_status": {"enum": ["PASS", "REVIEW", "FAIL"]},
              "terminal_route": {"type": "string", "minLength": 1},
              "stages_executed": {"type": "integer", "minimum": 0, "maximum": 4},
              "held_locks": {"const": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
