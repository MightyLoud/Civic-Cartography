{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "capacity",
    "automatic_retries",
    "public_release",
    "selection",
    "waves"
  ],
  "properties": {
    "gate_id": {
      "const": "ORCH-PROD-002"
    },
    "capacity": {
      "const": 2
    },
    "automatic_retries": {
      "const": false
    },
    "public_release": {
      "const": false
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr",
        "head_sha",
        "merge_sha",
        "workflow_run_id",
        "job_id",
        "status"
      ],
      "properties": {
        "pr": {
          "const": 462
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}$"
        },
        "merge_sha": {
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_run_id": {
          "type": "integer"
        },
        "job_id": {
          "type": "integer"
        },
        "status": {
          "const": "PASS"
        }
      }
    },
    "waves": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wave",
          "pr",
          "base_sha",
          "head_sha",
          "merge_sha",
          "workflow_run_id",
          "tasks"
        ],
        "properties": {
          "wave": {
            "enum": [
              "OR-PB04-A",
              "OR-PB04-B",
              "OR-PB04-C"
            ]
          },
          "pr": {
            "type": "integer"
          },
          "base_sha": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "head_sha": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "merge_sha": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "workflow_run_id": {
            "type": "integer"
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "production_acceptance",
                "deterministic",
                "nesting_parity",
                "enrichment_guard",
                "sequence",
                "target_id",
                "county",
                "geoid",
                "dependencies",
                "job_id",
                "production_run_id",
                "artifact_id",
                "artifact_sha256"
              ],
              "properties": {
                "sequence": {
                  "type": "integer"
                },
                "target_id": {
                  "pattern": "^OR-PB04-00[1-5]$"
                },
                "county": {
                  "type": "string"
                },
                "geoid": {
                  "pattern": "^410(07|09|11|13|15)$"
                },
                "dependencies": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "job_id": {
                  "type": "integer"
                },
                "production_run_id": {
                  "pattern": "^[0-9a-f]{20}$"
                },
                "artifact_id": {
                  "type": "integer"
                },
                "artifact_sha256": {
                  "pattern": "^[0-9a-f]{64}$"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "REVIEW",
                    "FAIL"
                  ]
                },
                "production_acceptance": {
                  "type": "boolean"
                },
                "deterministic": {
                  "type": "boolean"
                },
                "nesting_parity": {
                  "type": "boolean"
                },
                "enrichment_guard": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
