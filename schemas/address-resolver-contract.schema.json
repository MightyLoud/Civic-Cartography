{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicdata.tech/schemas/address-resolver-contract.schema.json",
  "title": "CivicData Address Resolver Contract",
  "type": "object",
  "required": ["contract_version", "records"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_id", "address_input", "normalized_address", "jurisdiction_id", "division_id", "boundary_source_id", "geocode", "local_layers", "evidence", "status", "raw_sha256"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "address_input": {"type": "string", "minLength": 1},
          "normalized_address": {"type": "string", "minLength": 1},
          "jurisdiction_id": {"type": "string", "pattern": "^jurisdiction-"},
          "division_id": {"type": "string", "pattern": "^division-"},
          "boundary_source_id": {"type": "string", "pattern": "^src-"},
          "geocode": {
            "type": "object",
            "required": ["lat", "lon", "provider", "confidence"],
            "properties": {
              "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
              "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
              "provider": {"type": "string", "minLength": 1},
              "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]}
            },
            "additionalProperties": false
          },
          "local_layers": {
            "type": "object",
            "required": ["resolved", "unresolved"],
            "properties": {
              "resolved": {"type": "array", "items": {"type": "string"}},
              "unresolved": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"enum": ["PASS", "PARTIAL", "FAIL"]},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
