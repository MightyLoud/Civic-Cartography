{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://civicdata.tech/schemas/orch-fac-003-batch.schema.json",
  "type":"object",
  "required":["version","max_parallel","nonwriting_workers","cases"],
  "properties":{
    "version":{"const":2},
    "max_parallel":{"type":"integer","minimum":2,"maximum":8},
    "nonwriting_workers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "cases":{"type":"array","minItems":4,"items":{"type":"object","required":["case_id","children"],"properties":{
      "case_id":{"type":"string","minLength":1},
      "children":{"type":"array","minItems":2,"items":{"type":"object","required":["task_id","domain_factory","worker","write_surface","stage_checks"],"properties":{
        "task_id":{"type":"string","minLength":1},"domain_factory":{"type":"string","minLength":1},"worker":{"type":"string","minLength":1},
        "write_surface":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "stage_checks":{"type":"object","required":["source"],"properties":{"source":{"$ref":"#/$defs/checks"},"domain":{"$ref":"#/$defs/checks"},"qa":{"$ref":"#/$defs/checks"},"rel":{"$ref":"#/$defs/checks"}},"additionalProperties":false}
      },"additionalProperties":false}}
    },"additionalProperties":false}}
  },
  "$defs":{"check":{"type":"object","required":["check_id","status","detail"],"properties":{"check_id":{"type":"string","minLength":1},"status":{"enum":["PASS","REVIEW","FAIL"]},"detail":{"type":"string","minLength":1}},"additionalProperties":false},"checks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/check"}}},
  "additionalProperties":false
}
