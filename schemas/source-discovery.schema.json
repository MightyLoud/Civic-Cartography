{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRC-FAC-001 Official Source Discovery Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_kind", "cases"],
  "properties": {
    "fixture_kind": {"const": "KNOWN_GOOD_DISCOVERY_CONTRACT"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "state", "jurisdiction", "record_type", "administering_authority", "candidate_sources", "disposition"],
      "properties": {
        "case_id": {"type": "string"},
        "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "jurisdiction": {"type": "string"},
        "record_type": {"type": "string"},
        "administering_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "level"],
          "properties": {
            "name": {"type": "string"},
            "level": {"enum": ["STATE", "COUNTY", "LOCAL"]}
          }
        },
        "candidate_sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "disposition": {"enum": ["READY", "REVIEW", "BLOCKED"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "source_type", "authority_level", "status", "schema_fingerprint", "adapter_id", "adapter_match"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "source_type": {"type": "string"},
        "authority_level": {"const": "OFFICIAL"},
        "status": {"enum": ["ACTIVE", "STALE", "BROKEN"]},
        "schema_fingerprint": {"type": "string"},
        "adapter_id": {"type": ["string", "null"]},
        "adapter_match": {"enum": ["EXACT", "LIKELY", "NONE"]}
      },
      "allOf": [
        {
          "if": {"properties": {"adapter_match": {"const": "NONE"}}, "required": ["adapter_match"]},
          "then": {"properties": {"adapter_id": {"type": "null"}}},
          "else": {"properties": {"adapter_id": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}
