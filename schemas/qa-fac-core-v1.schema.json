{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicdata.tech/schemas/qa-fac-core-v1.schema.json",
  "title": "QA-FAC Shared Core Report v1",
  "type": "object",
  "required": ["gate_id", "domain", "expected_status", "checks"],
  "properties": {
    "gate_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["NAT-FAC", "CAN-FAC", "GEO-FAC", "SRC-FAC"]},
    "expected_status": {"enum": ["PASS", "REVIEW", "FAIL"]},
    "checks": {
      "type": "object",
      "required": ["Q01", "Q02", "Q03", "Q04", "Q05", "Q06", "Q07", "Q08", "Q09", "Q10"],
      "properties": {
        "Q01": {"$ref": "#/$defs/check"},
        "Q02": {"$ref": "#/$defs/check"},
        "Q03": {"$ref": "#/$defs/check"},
        "Q04": {"$ref": "#/$defs/check"},
        "Q05": {"$ref": "#/$defs/check"},
        "Q06": {"$ref": "#/$defs/check"},
        "Q07": {"$ref": "#/$defs/check"},
        "Q08": {"$ref": "#/$defs/check"},
        "Q09": {"$ref": "#/$defs/check"},
        "Q10": {"$ref": "#/$defs/check"}
      },
      "additionalProperties": false
    },
    "domain_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"},
      "default": []
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["status", "detail"],
      "properties": {
        "status": {"enum": ["PASS", "REVIEW", "FAIL", "NA"]},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
